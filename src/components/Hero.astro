<section class="hero-mesh relative overflow-hidden border-b border-[var(--border)]">
  <div class="max-w-5xl mx-auto px-6 pt-20 pb-16 sm:pt-28 sm:pb-24">
    <!-- Intro line -->
    <div class="flex items-center gap-3 mb-6">
      <div class="w-2 h-2 rounded-full bg-[var(--accent)] animate-pulse"></div>
      <span class="text-sm text-[var(--tx-3)]">Security Engineer & Researcher</span>
    </div>

    <!-- Name + tagline -->
    <h1 class="text-4xl sm:text-6xl font-bold tracking-tight mb-4 leading-[1.1]">
      Hey, I'm <span class="grad">Sai</span>

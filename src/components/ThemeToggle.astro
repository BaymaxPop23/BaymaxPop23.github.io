<button id="theme-toggle" class="p-2 rounded-md text-[var(--tx-3)] hover:text-[var(--tx)] hover:bg-[var(--glow)] transition-all" aria-label="Toggle theme">
  <svg id="sun-icon" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
  <svg id="moon-icon" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
</button>
<script>
  function u(){const l=document.documentElement.classList.contains('light');document.getElementById('sun-icon')?.classList.toggle('hidden',l);document.getElementById('moon-icon')?.classList.toggle('hidden',!l);}u();
  document.getElementById('theme-toggle')?.addEventListener('click',()=>{const h=document.documentElement,l=h.classList.contains('light');h.classList.toggle('light',!l);h.classList.toggle('dark',l);localStorage.setItem('theme',l?'dark':'light');u();});
</script>

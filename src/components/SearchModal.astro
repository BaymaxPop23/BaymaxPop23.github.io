---
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const searchData = posts.map(post => ({
  title: post.data.title,
  description: post.data.description,
  tags: post.data.tags,
  slug: post.id,
}));
---

<div id="search-modal" class="hidden fixed inset-0 z-[100]">
  <div id="search-backdrop" class="absolute inset-0 bg-black/60 backdrop-blur-sm"></div>

  <div class="relative max-w-lg mx-auto mt-[20vh] px-4">
    <div class="bg-[var(--surface)] border border-[var(--border)] rounded-lg shadow-2xl overflow-hidden">
      <div class="flex items-center gap-3 px-4 py-3 border-b border-[var(--border)]">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--tx-3)] shrink-0">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
        <input
          id="search-input"
          type="text"
          placeholder="Search posts..."
          class="flex-1 bg-transparent outline-none text-sm text-[var(--tx)] placeholder-[var(--tx-3)]"
          autocomplete="off"
        />
        <kbd class="hidden sm:inline text-xs text-[var(--tx-3)] px-1.5 py-0.5 rounded border border-[var(--border)]">ESC</kbd>
      </div>

      <div id="search-results" class="max-h-72 overflow-y-auto p-2">
        <p class="px-3 py-6 text-center text-sm text-[var(--tx-3)]">Type to search...</p>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ searchData }}>
  const modal = document.getElementById('search-modal');
  const backdrop = document.getElementById('search-backdrop');
  const input = document.getElementById('search-input');
  const results = document.getElementById('search-results');

  function closeModal() {
    modal?.classList.add('hidden');
    if (input) input.value = '';
    if (results) results.innerHTML = '<p class="px-3 py-6 text-center text-sm" style="color: var(--tx-3);">Type to search...</p>';
  }

  backdrop?.addEventListener('click', closeModal);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });

  input?.addEventListener('input', (e) => {
    const query = e.target.value.toLowerCase().trim();
    if (!query) {
      results.innerHTML = '<p class="px-3 py-6 text-center text-sm" style="color: var(--tx-3);">Type to search...</p>';
      return;
    }

    const filtered = searchData.filter(post =>
      post.title.toLowerCase().includes(query) ||
      post.description.toLowerCase().includes(query) ||
      post.tags.some(tag => tag.toLowerCase().includes(query))
    );

    if (filtered.length === 0) {
      results.innerHTML = '<p class="px-3 py-6 text-center text-sm" style="color: var(--tx-3);">No results found.</p>';
      return;
    }

    results.innerHTML = filtered.map(post => `
      <a href="/blog/${post.slug}" class="block px-3 py-3 rounded-md transition-colors hover:bg-[var(--surface-hover)]">
        <div class="font-medium text-sm" style="color: var(--tx);">${post.title}</div>
        <div class="text-xs mt-1" style="color: var(--tx-3);">${post.description}</div>
        <div class="flex gap-1.5 mt-2">
          ${post.tags.map(tag => `<span class="text-xs px-1.5 py-0.5 rounded" style="background: var(--bg-2); color: var(--tx-2);">${tag}</span>`).join('')}
        </div>
      </a>
    `).join('');
  });
</script>
